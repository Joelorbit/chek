# ─── Supabase / Postgres (Drizzle ORM) ──────────────────────────────────
# See drizzle.md for complete Drizzle ORM patterns and queries.
# Direct/Session connection (port 5432) used for drizzle-kit migrations:
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Transaction pooler URL (port 6543) with prepare:false for runtime application:
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# ─── Server Configuration ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=https://chek.et

# ─── Admin Secret & Umami Analytics ────────────────────────────────────────
ADMIN_SECRET=your-32-char-random-admin-secret
# Paste your Umami Share URL here to embed live visitor/verification analytics in /admin
UMAMI_SHARE_URL=https://cloud.umami.is/share/your-share-token

# ─── Mistral Vision AI (Optional for screenshot OCR) ───────────────────────
MISTRAL_API_KEY=

# ─── Verification provider relays (Optional) ───────────────────────────────
SKIP_PRIMARY_VERIFICATION=false
FALLBACK_PROXIES=
TELEBIRR_PROXY_KEY=
